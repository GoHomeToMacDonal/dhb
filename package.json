{
  "name": "dhb",
  "version": "0.1.0",
  "description": "Modular command-line tool with a DeepSeek-powered git commit agent.",
  "type": "module",
  "bin": {
    "dhb": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:smoke": "node scripts/smoke-package.mjs",
    "bench:start": "node scripts/benchmark-startup.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
